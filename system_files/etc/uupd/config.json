{
    "checks": {
        "hardware": {
            "bat-min-percent": 20,
            "cpu-max-percent": 50,
            "enable": true,
            "mem-max-percent": 90,
            "net-max-bytes": 700000
        }
    },
    "logging": {
        "file": "-",
        "json": false,
        "level": "debug",
        "quiet": false
    },
    "modules": {
        "brew": {
            "cellar": "/home/linuxbrew/.linuxbrew/Cellar",
            "disable": true,
            "path": "/home/linuxbrew/.linuxbrew/bin/brew",
            "prefix": "/home/linuxbrew/.linuxbrew",
            "repository": "/home/linuxbrew/.linuxbrew/Homebrew"
        },
        "distrobox": {
            "binary-path": "/usr/bin/distrobox",
            "disable": false
        },
        "flatpak": {
            "binary-path": "/usr/bin/flatpak",
            "disable": false
        },
        "system": {
            "bootc-binary": "/usr/bin/bootc",
            "disable": false,
            "rpm-ostree-binary": "/usr/bin/rpm-ostree",
            "skopeo-binary": "/usr/bin/skopeo"
        }
    }
}
